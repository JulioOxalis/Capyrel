{
    "name": "julio/capyrel",
    "description": "Laravel scaffolding that reads your database and generates Eloquent relationships, API resources, form requests, and Pest tests automatically.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/JulioOxalis/Capyrel",
    "authors": [
        {
            "name": "Julio",
            "homepage": "https://github.com/JulioOxalis"
        }
    ],
    "keywords": [
        "laravel",
        "scaffold",
        "relationships",
        "eloquent",
        "artisan",
        "generator",
        "code-generator",
        "laravel-package",
        "schema",
        "migrations"
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Julio\\Capyrel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Julio\\Capyrel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Julio\\Capyrel\\CapyrelServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
