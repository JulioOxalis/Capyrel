{
    "Capyrel: forelse relationship": {
        "prefix": "cap:forelse",
        "body": [
            "@forelse(\\$${1:model}->${2:relation} as \\$${3:item})",
            "    {{ \\$${3:item}->${4:field} }}",
            "@empty",
            "    <p>No ${2:relation} yet.</p>",
            "@endforelse"
        ],
        "description": "Capyrel: forelse loop over a hasMany / belongsToMany relationship"
    },
    "Capyrel: whenLoaded check": {
        "prefix": "cap:whenloaded",
        "body": [
            "@if(\\$${1:model}->${2:relation})",
            "    {{ \\$${1:model}->${2:relation}->${3:field} }}",
            "@endif"
        ],
        "description": "Capyrel: conditional display for hasOne / belongsTo"
    },
    "Capyrel: Bootstrap form group": {
        "prefix": "cap:bsinput",
        "body": [
            "<div class=\"mb-3\">",
            "    <label for=\"${1:field}\" class=\"form-label\">${2:Label}</label>",
            "    <input type=\"${3:text}\" id=\"${1:field}\" name=\"${1:field}\"",
            "           value=\"{{ old('${1:field}') }}\"",
            "           class=\"form-control @error('${1:field}') is-invalid @enderror\">",
            "    @error('${1:field}')",
            "        <div class=\"invalid-feedback\">{{ \\$message }}</div>",
            "    @enderror",
            "</div>"
        ],
        "description": "Capyrel: Bootstrap 5 form input with error handling"
    },
    "Capyrel: Tailwind form group": {
        "prefix": "cap:twinput",
        "body": [
            "<div>",
            "    <label for=\"${1:field}\" class=\"block text-sm font-medium text-gray-700\">${2:Label}</label>",
            "    <input type=\"${3:text}\" id=\"${1:field}\" name=\"${1:field}\"",
            "           value=\"{{ old('${1:field}') }}\"",
            "           class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm @error('${1:field}') border-red-500 @enderror\">",
            "    @error('${1:field}')",
            "        <p class=\"mt-1 text-sm text-red-600\">{{ \\$message }}</p>",
            "    @enderror",
            "</div>"
        ],
        "description": "Capyrel: Tailwind CSS form input with error handling"
    },
    "Capyrel: CSRF delete form": {
        "prefix": "cap:delete",
        "body": [
            "<form action=\"{{ route('${1:route}.destroy', \\$${2:model}) }}\" method=\"POST\"",
            "      onsubmit=\"return confirm('Delete this ${3:item}?')\">",
            "    @csrf",
            "    @method('DELETE')",
            "    <button type=\"submit\">Delete</button>",
            "</form>"
        ],
        "description": "Capyrel: DELETE form with CSRF and confirmation"
    },
    "Capyrel: belongsToMany sync form": {
        "prefix": "cap:sync",
        "body": [
            "<form action=\"{{ route('${1:route}.sync${2:Related}', \\$${3:model}) }}\" method=\"POST\">",
            "    @csrf",
            "    @foreach(\\$${4:allItems} as \\$${5:item})",
            "        <label>",
            "            <input type=\"checkbox\" name=\"${6:relation}_ids[]\" value=\"{{ \\$${5:item}->id }}\"",
            "                {{ \\$${3:model}->${6:relation}->contains(\\$${5:item}) ? 'checked' : '' }}>",
            "            {{ \\$${5:item}->name }}",
            "        </label>",
            "    @endforeach",
            "    <button type=\"submit\">Update ${2:Related}</button>",
            "</form>"
        ],
        "description": "Capyrel: belongsToMany sync form with checkboxes"
    }
}
